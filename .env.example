# AstroCare brain connection — see README.md "Brain connection".
# Copy to .env (or .env.local) and adjust if the brain runs elsewhere.

# WebSocket stream of BrainTick JSON (one message per processed sample).
# Leave unset / empty to always use the in-browser mock.
NEXT_PUBLIC_BRAIN_WS_URL=ws://localhost:8787

# HTTP API of the brain's dashboard (POST /ingest, GET /state, /history, /log, /report,
# POST /ask). Not yet consumed by this app — reserved for the next phase (AI Assistant /
# Mission History wiring).
NEXT_PUBLIC_BRAIN_HTTP_URL=http://localhost:8765
